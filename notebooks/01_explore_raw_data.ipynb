   "source": [
    "import polars as pl\n",
    "df = pl.read_parquet(\"../data/raw/daily/sh.600000.parquet\")\n",
    "df.head(); df.describe()\n",
    "df.filter(pl.col(\"tradestatus\") == 0)               # 停牌日长什么样？\n",
    "df.filter((pl.col(\"close\")/pl.col(\"preclose\")-1 - pl.col(\"pct_chg\")/100).abs() > 1e-3)  # ret 和 pct_chg 对得上吗？"
   ]
